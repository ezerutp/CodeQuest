QFrame#Card {
    background: ${surface};
    border: 1px solid ${border};
    border-radius: 12px;
}

QFrame#Card[variant="hero"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 ${accent_soft}, stop:0.6 ${surface});
    border-color: ${border_strong};
}

QFrame#Card[variant="warning"] {
    background: ${warning_soft};
    border-color: ${warning};
}

QFrame#Card[interactive="true"]:enabled:hover {
    background: ${surface_hover};
    border-color: ${accent};
}

#StatValue { font-size: 28px; font-weight: 700; }
#StatLabel { color: ${text_muted}; font-size: 13px; }

#ModeTitle { font-size: 15px; font-weight: 600; }
#ModeDescription { color: ${text_muted}; font-size: 13px; }

/* Medidores (widgets/meter.py) y cifra principal */
QProgressBar#Meter {
    background: ${accent_soft};
    border: none;
    border-radius: 4px;
    min-height: 8px;
    max-height: 8px;
}
QProgressBar#Meter::chunk {
    background: ${accent};
    border-radius: 4px;
}
#MeterLabel { font-size: 14px; }
#MeterValue { font-size: 14px; font-weight: 600; }
#HeroValue { font-size: 52px; font-weight: 800; }
#TableHeader { color: ${text_subtle}; font-size: 11px; font-weight: 700; }
