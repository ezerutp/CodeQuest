/* Alternativas */
QFrame#Choice {
    background: ${surface};
    border: 1px solid ${border};
    border-radius: 10px;
}
QFrame#Choice:enabled:hover {
    background: ${surface_hover};
    border-color: ${accent};
}
QFrame#Choice[state="correct"] {
    background: ${success_soft};
    border-color: ${success};
}
QFrame#Choice[state="incorrect"] {
    background: ${danger_soft};
    border-color: ${danger};
}
QFrame#Choice[state="dimmed"] { background: ${bg}; }
QFrame#Choice[state="dimmed"] #ChoiceText { color: ${text_subtle}; }

#ChoiceLetter {
    background: ${surface_raised};
    border: 1px solid ${border};
    border-radius: 6px;
    color: ${text_muted};
    font-weight: 700;
    font-size: 13px;
}
QFrame#Choice[state="correct"] #ChoiceLetter {
    background: ${success};
    border-color: ${success};
    color: ${bg};
}
QFrame#Choice[state="incorrect"] #ChoiceLetter {
    background: ${danger};
    border-color: ${danger};
    color: ${bg};
}
#ChoiceText { font-size: 14px; }
/* Tras responder las opciones quedan deshabilitadas: la correcta y la elegida siguen legibles. */
QFrame#Choice[state="correct"] #ChoiceText,
QFrame#Choice[state="incorrect"] #ChoiceText { color: ${text}; }

/* Enunciado y retroalimentación */
#QuestionPrompt { font-size: 19px; font-weight: 600; }

QFrame#Card[variant="success"] { border-color: ${success}; }
QFrame#Card[variant="danger"] { border-color: ${danger}; }
QFrame#Card[variant="partial"] { border-color: ${warning}; }
QFrame#Card[variant="analogy"] {
    background: ${accent_soft};
    border-color: ${accent_soft};
}
QFrame#Card[variant="ai"] {
    background: ${surface_raised};
    border: 1px solid ${accent};
}
#FeedbackTitle { font-size: 16px; font-weight: 700; }
#FeedbackTitle[tone="success"] { color: ${success}; }
#FeedbackTitle[tone="danger"] { color: ${danger}; }
#FeedbackTitle[tone="warning"] { color: ${warning}; }
#FeedbackTitle[tone="info"] { color: ${syntax_annotation}; }
#FeedbackBody { color: ${text}; font-size: 14px; }

/* Encuentra el error */
#DiffLine {
    font-family: "JetBrains Mono", "Fira Code", "Source Code Pro", "DejaVu Sans Mono", monospace;
    font-size: 13px;
    border-radius: 6px;
    padding: 6px 10px;
}
#DiffLine[tone="added"] { background: ${success_soft}; color: ${text}; border: 1px solid ${success}; }
#DiffLine[tone="removed"] { background: ${danger_soft}; color: ${text}; border: 1px solid ${danger}; }
#SelectedLine { color: ${text_muted}; font-size: 13px; }

#ScoreValue { font-size: 44px; font-weight: 800; }
