QPlainTextEdit#CodeEditor {
    background: ${editor_bg};
    border: 1px solid ${border};
    border-radius: 10px;
    color: ${text};
    selection-background-color: ${editor_selection};
    selection-color: ${text};
    padding: 6px 0;
}
QPlainTextEdit#CodeEditor[readOnly="false"] { border-color: ${border_strong}; }
QPlainTextEdit#CodeEditor:focus[readOnly="false"] { border-color: ${accent}; }

#EditorHeader {
    color: ${text_muted};
    font-size: 12px;
}

/* Lista de sugerencias del editor (QCompleter): ventana emergente, estilo de menú del IDE */
QListView#CompletionPopup {
    background: ${surface_raised};
    border: 1px solid ${border_strong};
    border-radius: 6px;
    color: ${text};
    outline: none;
    padding: 4px;
}
QListView#CompletionPopup::item { padding: 3px 6px; border-radius: 4px; }
QListView#CompletionPopup::item:selected { background: ${accent_soft}; color: ${text}; }
QListView#CompletionPopup::item:hover { background: ${surface_hover}; }
